  Description: checkbox_text_color_selector.xml defines a color selector that
  changes the text color based on the checked state. It applies a primary color
  when checked and a default color when unchecked.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/colorPrimaryFxd" android:state_checked="true" />
    <item android:color="@color/black" android:state_checked="false" />
</selector>
