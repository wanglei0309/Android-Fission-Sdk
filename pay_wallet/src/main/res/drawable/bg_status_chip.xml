  Description:
  bg_status_chip.xml defines the pill background of the wearable status chips shown above the
  payment card list. The corner radius is deliberately larger than the chip height so the ends stay
  fully rounded whatever the label length.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/white" />
    <stroke
        android:width="1dp"
        android:color="@color/lightGrey" />
    <corners android:radius="@dimen/dp20" />
</shape>
