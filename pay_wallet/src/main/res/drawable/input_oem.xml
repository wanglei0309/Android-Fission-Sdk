  Description: bg_rectangle_light_black_stroke.xml defines a rectangular
  shape drawable with a 1dp light black stroke and 4dp rounded corners.
  It is intended for use as a subtle outlined background for UI elements
  such as buttons, cards, or input fields where a neutral border is required.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <stroke android:width="1dp" android:color="@color/light_black"/>
    <corners android:radius="4dp"/>
</shape>
