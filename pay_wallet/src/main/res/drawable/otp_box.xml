  Description:
  bg_rectangle_white_black_stroke.xml defines a rectangular shape with a white
  background, a 2dp black border, and rounded corners. It is used as a basic
  background for UI elements such as buttons or containers.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF"/>
    <stroke android:width="1dp" android:color="#8D8786"/>
    <corners android:radius="1dp"/>
</shape>
