  Description:
  bg_rectangle_white_thin_black_stroke.xml defines a rectangular shape with a
  white background, a thin 1dp black border, and rounded corners. It is used as
  a simple outlined background for UI components.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF"/>
    <stroke android:width="1dp" android:color="#000000"/>
    <corners android:radius="4dp"/>
</shape>