  Description:
  bg_toggle_selector.xml defines a state-based background for a toggle or
  selectable UI element. When checked, it shows a rounded rectangle filled
  with the primary color. When unchecked, it displays a white background
  with a light gray border.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimaryFxd"/> <corners android:radius="50dp"/>
        </shape>
    </item>

    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/> <corners android:radius="50dp"/>
            <stroke android:width="1dp" android:color="#CCCCCC"/> </shape>
    </item>
</selector>