  Description: layout_intro_screen.xml defines a layout for the introduction
  screen. It contains a full-width ImageView centered vertically with a top
  margin to display the intro_1 drawable, suitable for onboarding or welcome
  visuals in the application.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp300"
        android:layout_marginTop="@dimen/dp150"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/intro_1" />

</androidx.constraintlayout.widget.ConstraintLayout>