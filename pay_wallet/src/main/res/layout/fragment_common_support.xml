  Description: layout_email_info.xml defines a ScrollView containing a
  ConstraintLayout with a TextView to display an email field with an icon.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvMail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_mail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/email"
                android:textSize="@dimen/sp18"
                android:gravity="center_vertical"
                android:drawablePadding="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextStyle400" />

            <TextView
                android:id="@+id/tvCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_phone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMail"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/call"
                android:textSize="@dimen/sp18"
                android:gravity="center_vertical"
                android:drawablePadding="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextStyle400" />

            <TextView
                android:id="@+id/tvWebsite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_website"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCall"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/visit_website"
                android:textSize="@dimen/sp18"
                android:gravity="center_vertical"
                android:drawablePadding="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextStyle18GreenRegular" />

            <TextView
                android:id="@+id/tvOpenApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_open_app"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvWebsite"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/open_app"
                android:textSize="@dimen/sp18"
                android:gravity="center_vertical"
                android:drawablePadding="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextStyle18GreenRegular" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/footerLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvOpenApp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="30dp">

                <TextView
                    android:id="@+id/tvTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/terms_condition"
                    android:textSize="@dimen/sp18"
                    android:gravity="center"
                    android:textAppearance="@style/TextStyle18GreenRegular" />

                <TextView
                    android:id="@+id/tvOr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvTerms"
                    android:text="@string/pipe_symbol"
                    android:gravity="center"
                    android:textSize="@dimen/sp18"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@+id/tvOr"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/privacy_policy"
                    android:textSize="@dimen/sp18"
                    android:gravity="start"
                    android:layout_marginStart="10dp"
                    android:textAppearance="@style/TextStyle18GreenRegular" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>