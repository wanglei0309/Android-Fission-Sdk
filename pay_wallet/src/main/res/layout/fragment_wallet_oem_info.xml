  Description: layout_oem_info.xml defines a ConstraintLayout displaying OEM
  information with two TextViews for SE type info and OEM ID.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_oem_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp70"
        android:text="@string/oem_se_type_info"
        android:textSize="@dimen/sp18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_oem_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginTop="@dimen/dp20"
        android:text="@string/text_oem_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_oem_info" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_oem_id"
        style="@style/TextStyle400"
        android:layout_height="@dimen/dp50"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp20"
        android:background="@drawable/input_oem"
        android:inputType="number"
        android:paddingStart="@dimen/dp10"
        android:paddingEnd="@dimen/dp12"
        android:textSize="@dimen/sp18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_oem_id" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_view_se_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginTop="@dimen/dp20"
        android:text="@string/text_se_type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_oem_id" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_se_type"
        style="@style/TextStyle400"
        android:layout_height="@dimen/dp50"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp20"
        android:background="@drawable/input_oem"
        android:inputType="textEmailAddress"
        android:paddingStart="@dimen/dp10"
        android:paddingEnd="@dimen/dp12"
        android:textSize="@dimen/sp18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_view_se_type" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_save"
        style="@style/AppButton.CustomButton"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginEnd="@dimen/dp20"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textSize="@dimen/sp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_se_type" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_cancel"
        style="@style/TextStyle600"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp20"
        android:layout_marginTop="@dimen/dp20"
        android:layout_marginEnd="@dimen/dp20"
        android:background="@drawable/bg_rectangle_primary_stroke"
        android:fontFamily="@font/sans3"
        android:textFontWeight="700"
        android:gravity="center"
        android:text="@string/btn_cancel"
        android:textAllCaps="false"
        android:textColor="@color/colorPrimaryFxd"
        android:textSize="@dimen/sp16"
        app:layout_constraintTop_toBottomOf="@+id/btn_save" />

</androidx.constraintlayout.widget.ConstraintLayout>