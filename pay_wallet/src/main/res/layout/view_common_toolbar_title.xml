  Description: layout_custom_toolbar.xml defines a custom toolbar layout. It
  uses a ConstraintLayout with a nested Toolbar to provide ActionBar integration
  while maintaining a white background and elevation for shadow effects.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/custom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Invisible Toolbar for ActionBar integration -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- LEFT ICON CONTAINER -->
        <LinearLayout
            android:id="@+id/toolbar_left_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- RIGHT ICON CONTAINER -->
        <LinearLayout
            android:id="@+id/toolbar_right_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/profile_icon"
                android:layout_width="@dimen/dp28"
                android:layout_height="@dimen/dp28"
                android:layout_marginEnd="@dimen/dp8"
                android:background="@drawable/bg_oval_grey"
                android:contentDescription="@string/profile"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_user_avatar" />
        </LinearLayout>

        <!-- CENTER TITLE -->
        <FrameLayout
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:fontFamily="@font/sans3"
                android:textFontWeight="700"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/menu_home"
                android:textColor="#1D1D1D"
                android:textSize="@dimen/sp18" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        android:background="@color/bluetooth_device_select_background"
        app:layout_constraintTop_toBottomOf="@id/custom_toolbar" />
</androidx.constraintlayout.widget.ConstraintLayout>