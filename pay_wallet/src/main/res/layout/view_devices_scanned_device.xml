  Description: layout_card_device.xml defines a ConstraintLayout representing a card
  item with device image, name, wallet icon, and Bluetooth status indicator.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardViewAdapter"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp10"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cardImageView"
            android:layout_width="34dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_watch" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_device_name"
            style="@style/TextStyle400"
            android:layout_width="@dimen/dp0"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:layout_marginStart="@dimen/dp30"
            android:scrollHorizontally="false"
            android:singleLine="false"
            android:text="@string/card_number"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardImageView"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_bluetooth"
            android:layout_width="@dimen/dp40"
            android:layout_height="@dimen/dp40"
            android:contentDescription="@null"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/img_device_settings"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_bluetooth_disconnected" />

        <!--
          Opens the wearable configuration screen. Hidden by default because this row is shared by
          the device list, terms, add-card and detail screens; only the wallet card list shows it.
        -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_device_settings"
            android:layout_width="@dimen/dp40"
            android:layout_height="@dimen/dp40"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/wearable_configuration"
            android:padding="@dimen/dp8"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_wearable_settings" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp1"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp10"
        android:background="@color/bluetooth_device_select_background"
        app:layout_constraintTop_toBottomOf="@id/cl_main" />

</androidx.constraintlayout.widget.ConstraintLayout>